# Ignore everything by default
/*

# Allow these specific files/folders
!README.md
!app/
!build.gradle.kts
!settings.gradle.kts
!gradle.properties
!.gitignore

# Inside app/, ignore build and other generated files
app/build/
app/*.iml
app/local.properties
app/google-services.json

# Ignore sensitive keys even if unignored by mistake
/Keys/
*.jks
*.keystore
